# Copy to .env and fill in. Never commit .env
DATABASE_URL=postgresql+psycopg://devintel:devintel@localhost:5432/devintel
# Create at https://github.com/settings/tokens (no scopes needed for public data)
GITHUB_TOKEN=
# Optional but recommended: raises Stack Exchange quota from 300 to 10,000 requests/day
# Register an app at https://stackapps.com/apps/oauth/register (key only, no secret needed)
STACKEXCHANGE_KEY=

# --- Google login (optional; see README "Google login setup") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Development: http://localhost:5173 (always open the app at that address). Production: https://your-domain
PUBLIC_BASE_URL=http://localhost:5173
COOKIE_SECURE=false

# Comma-separated Google emails that become administrators when they sign in (admins can appoint moderators)
ADMIN_EMAILS=
